# Leave POSTGRES_URL unset for local dev — the app falls back to a local
# SQLite file at data/ownership.db automatically.
#
# When deploying to Vercel, add a Postgres database (Vercel Storage -> Postgres,
# or Neon) and Vercel will inject POSTGRES_URL for you automatically.
# POSTGRES_URL=postgres://user:pass@host:5432/dbname

# Optional shared secret required on /api/cron and /api/snapshot to stop
# randoms from spamming the FPL API through your deployment.
# CRON_SECRET=change-me
